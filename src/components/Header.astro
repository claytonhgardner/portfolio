---
import Monogram from './Monogram.astro';
interface Props { name: string }
const { name } = Astro.props;
const links = [
  { href: '#about', label: 'About' },
  { href: '#work', label: 'Work' },
  { href: '#contact', label: 'Contact' },
];
---
<header class="sticky top-0 z-50 border-b border-ink/10 bg-cream/95 backdrop-blur supports-[backdrop-filter]:bg-cream/85">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
    <a href="#top" class="flex items-center gap-2.5 font-bold uppercase tracking-[0.12em] text-ink no-underline">
      <Monogram class="h-8 w-auto text-teal" />
      <span class="text-sm sm:text-base">{name}</span>
    </a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-1 sm:gap-2">
        {links.map((l) => (
          <li>
            <a href={l.href} class="block rounded-md px-2 py-2 text-sm font-semibold text-ink hover:bg-sage/60 hover:underline sm:px-3 sm:text-base">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
