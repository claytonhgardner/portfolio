---
import { Picture } from 'astro:assets';
import { resolveImage } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}
const {
  src,
  alt,
  sizes = '(min-width: 64rem) 40vw, 92vw',
  class: className,
  loading = 'lazy',
} = Astro.props;

const img = resolveImage(src);
const isSvg = img?.format === 'svg';
// Never upscale: only offer widths up to the file's real width.
const widths = img
  ? [...new Set([480, 800, 1200, 1600, 2000].filter((w) => w < img.width).concat(img.width))]
  : [];
---
{img && (isSvg ? (
  <img src={img.src} width={img.width} height={img.height} alt={alt} class={className} loading={loading} decoding="async" />
) : (
  <Picture
    src={img}
    alt={alt}
    widths={widths}
    sizes={sizes}
    formats={['avif', 'webp']}
    pictureAttributes={{ class: 'block min-w-0 max-w-full' }}
    class={className}
    loading={loading}
    decoding="async"
  />
))}
